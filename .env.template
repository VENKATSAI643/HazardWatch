# ============================================================
# HazardWatch — Project Environment Variables Template
#
# Use this file as a reference for the Environment Variables you
# need to set in the Azure Portal (App Settings) or GitHub Secrets.
# 
# DO NOT put real values in this .env.template file! 
# Copy this to a file named `.env` and put your real values there.
# The .gitignore is already set to ignore `.env`.
# ============================================================

# 1. Azure Storage & Config
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID_HERE
ADLS_ACCOUNT_NAME=hazardwatchraw
ADLS_CONTAINER_NAME=raw
ADLS_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=hazardwatchraw;AccountKey=YOUR_STORAGE_KEY;EndpointSuffix=core.windows.net

# 2. Public API Keys
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY_HERE

# 3. Application Settings
# Bounding box for FIRMS (min_lon, min_lat, max_lon, max_lat)
FIRMS_BBOX=68,6,98,37

# 4. Iceberg Local Config (Only needed if running locally)
ICEBERG_CATALOG_URI=sqlite:///tmp/hazardwatch_iceberg.db
